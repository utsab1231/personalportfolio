# Cache optimized media aggressively — filenames are content-hashed by the
# optimize-media script (base-width.ext), so immutable caching is safe.
/tryouts/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts self-hosted by next/font are fingerprinted too.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable